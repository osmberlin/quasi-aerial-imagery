{
  "name": "streetlevel-ortho-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Local viewer for orthophoto results on a map",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "sample-data": "bun scripts/make-sample-data.ts",
    "type-check": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "oxlint --deny-warnings -c oxlint.config.mjs .",
    "format": "oxfmt --write -c oxfmt.config.mjs .",
    "format-check": "oxfmt --check -c oxfmt.config.mjs .",
    "test": "vitest run --passWithNoTests",
    "check": "bun run --parallel type-check lint format-check test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@turf/distance": "^7.4.0",
    "maplibre-gl": "^6.13.0",
    "react": "^19",
    "react-dom": "^19",
    "react-map-gl": "^8.1.3",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "bun-types": "^1.4.2",
    "oxc-transform-react": "^0.152.0",
    "oxfmt": "0.60.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "^7",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
